---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { title, description, status, stack, cover } = project.data;

const coverUrl = cover ? getAssetPath(cover) : undefined;

const statusLabels = {
  active: "进行中",
  completed: "已完成",
  archived: "已归档",
};
---

<article
  class="border-border bg-background group flex h-full flex-col overflow-hidden rounded-lg border transition-transform duration-200 hover:-translate-y-1"
>
  <a
    href={getRelativeLocaleUrl(
      Astro.currentLocale ?? "zh-CN",
      `projects/${project.id}`
    )}
    class="focus-outline block focus-visible:no-underline"
  >
    <div class="bg-muted aspect-[16/9] overflow-hidden">
      {
        coverUrl ? (
          <img
            src={coverUrl}
            alt={`${title} 项目预览`}
            width="800"
            height="450"
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : (
          <div class="text-accent flex h-full items-center justify-center text-4xl font-bold">
            {title.slice(0, 1)}
          </div>
        )
      }
    </div>
    <div class="flex flex-1 flex-col p-5">
      <div class="flex items-center justify-between gap-3">
        <span class="text-muted-foreground text-xs tracking-widest uppercase">
          {statusLabels[status]}
        </span>
        <IconArrowRight
          class="text-accent size-5 transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </div>
      <h3 class="mt-3 text-xl font-semibold">{title}</h3>
      <p class="text-muted-foreground mt-2 flex-1 leading-7">
        {description}
      </p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="技术栈">
        {
          stack
            .slice(0, 4)
            .map(item => (
              <li class="bg-muted rounded px-2.5 py-1 text-xs">{item}</li>
            ))
        }
      </ul>
    </div>
  </a>
</article>
